  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ChallengeTrigger
  data:
    title: 'SECURITY CHECK: SAFE OR SUSPICIOUS?'
    question: Three apps (the three gates, left to right) ask to be installed. Which one is the safe choice?
    options:
    - 'Left gate: ''FreeVideoPro_crack.exe'' from a random forum link'
    - 'Middle gate: the official app from the publisher''s verified store, with a valid signature'
    - 'Right gate: ''Invoice.exe'' attached to an unexpected email'
    correctIndex: 1
    explanation: A Trojan looks useful but hides harmful code. Install software only from the official, verified source and check the publisher's digital signature.
  gatesToOpen:
  - {fileID: 1329335326}
