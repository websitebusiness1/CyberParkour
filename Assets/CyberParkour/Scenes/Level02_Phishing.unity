  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f1eeebad5b2feba566c68c8e8b7a9d0b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ChallengeTrigger
  data:
    title: 'SECURITY CHECK: PHISHING'
    question: 'You get a message: "Your account is locked! Click this link and enter your password now." What is the best response?'
    options:
    - Click the link and log in quickly before the account closes
    - Don't use the link. Open the official site by typing the address yourself, or contact the company
    - Reply with your password so they can verify you
    - Forward it to all your friends as a warning
    correctIndex: 1
    explanation: Urgent threats plus a link are classic phishing. Never log in through a message - go to the real website yourself.
  gatesToOpen:
  - {fileID: 333411809}
